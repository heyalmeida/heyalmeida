# --- dependencies -------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
yarn.lock

# --- agent / local tooling ----------------------------------------------------
# Émile CLI workspace (session history, model cache) — never belongs in the repo.
.emile/

# --- secrets & local config ---------------------------------------------------
.env
.env.*
!.env.example

# --- logs & caches ------------------------------------------------------------
*.log
npm-debug.log*
tmp/
temp/
*.tmp

# --- editors & OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- note ---------------------------------------------------------------------
# assets/*.svg and data/contributions.json are generated by scripts/ but are
# committed on purpose: they are the README artwork, served straight from the
# repo so the profile never depends on a third-party stats service.
# Regenerate with: npm run art   (or: node scripts/fetch-contributions.mjs)